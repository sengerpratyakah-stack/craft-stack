# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Server Port (defaults to 3000)
PORT="3000"

# Optional Email Delivery via Resend (https://resend.com)
# If omitted, contact inquiries are validated and stored locally in data/inquiries.json
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""
CONTACT_TO_EMAIL=""

# Optional Webhook URL (e.g. Slack, Discord, or Make/Zapier) for instant inquiry alerts
CONTACT_WEBHOOK_URL=""

# Optional Owner Coupon Studio Passcode (if omitted, first-time setup lets you set it in the UI)
COUPON_ADMIN_PASSCODE=""

# Optional Configurable Social Links (defaults are set in src/config/social.ts)
VITE_SOCIAL_LINKEDIN=""
VITE_SOCIAL_INSTAGRAM=""
VITE_SOCIAL_X=""
VITE_SOCIAL_GITHUB=""
VITE_SOCIAL_DRIBBBLE=""
